# ============================================================
# PixelArtist 网站环境变量示例
# 复制为 .env.local (本地) 或在 Vercel/Supabase Dashboard 设置
# ============================================================

# --- Supabase ---
# Project URL (Settings → API Keys → 页面顶部)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co

# Publishable key (Settings → API Keys → API Keys tab)
# 新版 Dashboard 名称:Publishable,旧版:Anon
# 代码也兼容旧名 NEXT_PUBLIC_SUPABASE_ANON_KEY(二选一即可,推荐用下面这个名字)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# Service role / Secret key (同上)
# ⚠️ 绝对不要加 NEXT_PUBLIC_ 前缀!只在服务端用
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxx

# --- Paddle 在线支付 (可选;不配就只走激活码 + 发卡平台) ---
# 控制台: https://vendors.paddle.com (测试环境用 sandbox)
PADDLE_ENV=production            # production | sandbox
PADDLE_API_KEY=pdl_live_xxxxxxxxx

# Webhook: Paddle → Developer Tools → Notifications → 新建
# 地址填 https://你的域名/api/paddle/webhook,勾选 transaction.completed
PADDLE_WEBHOOK_SECRET=pdl_ntfset_xxxxxxxxx

# 四个套餐对应的 price_id (Paddle → Catalog → Products 里建好商品后复制 pri_xxx)
PADDLE_PRICE_YEARLY=pri_xxxxxxxxx
PADDLE_PRICE_MONTHLY=pri_xxxxxxxxx
PADDLE_PRICE_LIFETIME=pri_xxxxxxxxx
PADDLE_PRICE_STUDENT=pri_xxxxxxxxx

# --- 下载版本 (release.ts 已硬编码,这里可覆盖) ---
NEXT_PUBLIC_DOWNLOAD_VERSION=0.1.0
